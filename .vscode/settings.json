{
	"editor.formatOnSave": true,
	"editor.formatOnPaste": true,
	"editor.defaultFormatter": "esbenp.prettier-vscode",
	"cssVariables.lookupFiles": [
		"node_modules/open-props/open-props.min.css",

		"**/*.css",
		"**/*.scss",
		"**/*.sass",
		"**/*.less"
	],
	"cssVariables.languages": [
		"astro",
		"svelte",
		"vue",
		"vue-html",
		"vue-postcss",
		"scss",
		"postcss",
		"less",
		"css",
		"html",
		"javascript",
		"javascriptreact",
		"typescript",
		"typescriptreact",
		"source.css.styled"
	]
}
