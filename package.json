{
	"name": "portfolio",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@12.0.0",
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "^22.18.0",
			"onFail": "download"
		}
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && vite build -c src/lib/cms/vite.config.ts && pagefind --site build",
		"preview": "node scripts/serve.ts",
		"prepare": "svelte-kit sync || echo ''",
		"postinstall": "node scripts/image-cache-link.ts",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "BASE_PATH=/portfolio pnpm build && playwright test",
		"data:symbols": "node scripts/symbols.ts",
		"data:cursor-gif": "node scripts/cursor-gif.ts",
		"content:format": "node scripts/content-format.ts",
		"image-cache:link": "node scripts/image-cache-link.ts",
		"image-cache:tidy": "node scripts/image-cache-tidy.ts"
	},
	"devDependencies": {
		"@fontsource-variable/fira-code": "^5.3.0",
		"@humanspeak/svelte-markdown": "2.2.0",
		"@mdsvex/plugin-external-links": "0.1.1",
		"@playwright/test": "1.64.1",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/enhanced-img": "^1.0.1",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@sveltia/cms": "0.268.0",
		"@twinkleplop/bash": "0.1.9",
		"@twinkleplop/css": "0.1.9",
		"@twinkleplop/diff": "0.1.9",
		"@twinkleplop/html": "0.1.9",
		"@twinkleplop/http": "0.1.9",
		"@twinkleplop/javascript": "0.1.9",
		"@twinkleplop/json": "0.1.9",
		"@twinkleplop/markdown": "0.2.3",
		"@twinkleplop/svelte": "0.1.9",
		"@twinkleplop/typescript": "0.1.9",
		"@twinkleplop/yaml": "0.1.9",
		"@types/node": "^26.6.6",
		"lucide": "1.66.0",
		"marked": "18.2.0",
		"mdsvex": "1.0.1",
		"open-props": "^1.7.23",
		"pagefind": "1.6.0",
		"postcss-jit-props": "^1.0.16",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.1.1",
		"sharp": "0.35.5",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"vite": "^8.3.8",
		"vitest": "5.1.0",
		"yaml": "^2.9.1"
	},
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@lucide/svelte": "^1.73.0",
		"simple-icons": "^16.38.0"
	}
}
