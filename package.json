{
	"name": "portfolio",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@12.0.0",
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "^22.17.1",
			"onFail": "download"
		}
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "BASE_PATH=/portfolio vite build && playwright test",
		"data:symbols": "node scripts/symbols.ts",
		"data:cursor-gif": "node scripts/cursor-gif.ts"
	},
	"devDependencies": {
		"@fontsource-variable/fira-code": "^5.3.0",
		"@fontsource-variable/shantell-sans": "^5.3.0",
		"@playwright/test": "1.64.1",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/enhanced-img": "^1.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^26.6.5",
		"lucide": "1.66.0",
		"mdsvex": "0.12.8",
		"open-props": "^1.7.23",
		"postcss-jit-props": "^1.0.16",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"rehype-autolink-headings": "7.1.0",
		"rehype-slug": "6.0.0",
		"sharp": "0.35.5",
		"shiki": "^4.5.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "5.1.0",
		"yaml": "^2.9.1"
	},
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@lucide/svelte": "^1.66.0",
		"simple-icons": "^16.36.0"
	}
}
